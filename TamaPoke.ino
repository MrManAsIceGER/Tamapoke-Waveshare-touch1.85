void setup() {
  // GPIO7 (BAT Control) sofort setzen, damit die Batterie-Versorgung
  // Keep the battery supply enabled throughout initialization.
  pwrSetup();

  Serial.setRxBufferSize(8192);  // SD transfers arrive in 2 KB blocks
  Serial.begin(115200);
  // CRITICAL: without this, Serial.print BLOCKS the game when no
  // serial monitor is open on the host (the USB CDC TX buffer fills
  // and nobody drains it) -> with timeout 0, messages are discarded
  Serial.printf("TamaPoke fw v%s\n", FW_VERSION);
  loadLang();  // Saved language (English by default)
  // Bus I2C principal: RTC y sensores (GPIO11/GPIO10).
  Wire.begin(IIC_SDA, IIC_SCL);
  Wire.setTimeOut(50);

  // TCA9554: EXIO1 = Touch-Reset, EXIO2 = LCD-Reset.
  if (!tca9554Begin(Wire)) {
    Serial.println("FEHLER: TCA9554 konnte nicht initialisiert werden");
    return;
  }

  // Touch-Controller vor dem ersten I2C-Zugriff per TCA9554 zuruecksetzen.
  if (!tca9554PulseReset(EXIO_TP_RESET, 10, 60)) {
    Serial.println("WARNUNG: CST816 Reset ueber EXIO1 fehlgeschlagen");
  }

  // Separater Touch-I2C-Bus: SDA=GPIO1, SCL=GPIO3, Adresse 0x15.
  bool touchBusOk = TouchWire.begin(TP_IIC_SDA, TP_IIC_SCL, 400000);
  if (touchBusOk) {
    TouchWire.setTimeOut(50);
  } else {
    Serial.println("FEHLER: Touch-I2C auf GPIO1/GPIO3 konnte nicht gestartet werden");
  }

  // ST77916 QSPI initialisieren. Der Canvas bleibt im originalen 466x466-Raum;
  // TamaPoke_ST77916_Output scales it to 360x360 during flush.
  Backlight_Init();
  if (!gfx->begin(80000000)) {
    Serial.println("FEHLER: ST77916 / QSPI oder 466x466-Framebuffer-Initialisierung fehlgeschlagen");
    return;
  }
  Set_Backlight(71);
  applyLangFont();

  // CST816: Reset erfolgt hardwareseitig ueber TCA9554 EXIO1.
  touch.setPins(TP_RESET, TP_INT);
  bool touchOk = false;
  if (touchBusOk) {
    for (int i = 0; i < 3 && !touchOk; i++) {
      touchOk = touch.begin(TouchWire, CST816_ADDR, TP_IIC_SDA, TP_IIC_SCL);
      if (!touchOk) delay(150);
    }
  }

  if (!touchOk) {
    Serial.println("CST816 nicht erkannt (I2C 0x15, SDA=1, SCL=3)");
  } else {
    // Raw CST816 coordinates are scaled to the logical 466x466 game area.
    touch.setResolution(LCD_WIDTH, LCD_HEIGHT);
    touch.setTargetResolution(GAME_WIDTH, GAME_HEIGHT);
    // Measurements showed that the coordinates are correctly oriented without mirroring
    // (top = small Y, bottom = large Y; left = small X,
    // right = large X). A 180-degree mirror reverses both axes.
    touch.setMirrorXY(false, false);
    Serial.printf("Touch bereit: %s, Adresse 0x%02X\n",
                  touch.getModelName(), CST816_ADDR);
  }

  // INT is active-low: query the I2C bus only when a touch event occurs.
  pinMode(TP_INT, INPUT_PULLUP);
  attachInterrupt(digitalPinToInterrupt(TP_INT), touchIsr, FALLING);

  pet.begin();
  sdBegin();
  thumbs.load();

  // Real-time clock: apply the time elapsed while the device was off
  rtcBegin();
  batBegin();
  uint32_t e = rtcEpoch();
  if (e == 0) {
    // Without a backup battery, the PCF85063 loses its time when power is removed.
    // Always seeding a fixed date would move game time BACKWARD compared with the saved
    // state, breaking the streak, age, and scene clock. Seed from the last time seen,
    // if that value is later, so time never moves backward. Time elapsed while powered off
    // is still lost (without an RTC there is no way to recover it), but the saved state stays consistent.
    // as well (without an RTC there is no way to know them), but nothing becomes inconsistent.
    uint32_t seed = 1767225600UL;             // RTC virgen de verdad
    uint32_t seen = pet.savedEpoch();         // Use the NVS instance that pet has already opened
    if (seen > seed) seed = seen;
    rtcSetEpoch(seed);
    e = rtcEpoch();
    Serial.printf("RTC sin hora: sembrado en %u%s\n", seed,
                  seen > 1767225600UL ? " (desde la ultima hora guardada)" : "");
  }
  pet.syncClock(e);

  audioBegin();  // ES8311 + I2S + amplifier (plays a startup jingle)

  lastInteract = millis();
}

// Load/unload the SD sprite when the species changes
void ensureMon() {
  if (pet.speciesId == monFor && monShinyFor == pet.shiny && !sdDirty) return;
  // Newly received files may include an updated thumbs.bin, which was previously
  // loaded only in setup(); without this reload it stayed invisible in the Pokédex until reboot
  if (sdDirty) { thumbs.unload(); thumbs.load(); sdEpoch++; }
  sdDirty = false;
  monFor = pet.speciesId;
  monShinyFor = pet.shiny;
  mon.unload();
  pmd.unload();
  beh.x = beh.targetX = 233;
  beh.mode = 0;
  beh.until = 0;
  if (pet.speciesId >= 1 && pet.speciesId <= DEX_COUNT) {
    pmd.load(pet.speciesId, pet.shiny);          // principal: PMD
    if (!pmd.loaded) mon.load(pet.speciesId, pet.shiny);  // respaldo: B/N
  }
}

void loop() {
  uint32_t now = millis();
  pet.update(now);

  // The amplifier follows the pet's sleep state (the call is a no-op if it has not changed).
  // This covers every path: the Light button, nighttime sleep, and sleep state
  // applied by offline progression.
  audioSetSleeping(pet.sleeping);

  // Play a sound when the pet becomes eligible to evolve
  // (including when the requirement is met while waking up). canEvolveNow is false while asleep.
  static bool wasEvoReady = false;
  bool evoReady = pet.wantEvolveButton();
  if (evoReady && !wasEvoReady) sfxPlay(SFX_MEDAL);
  wasEvoReady = evoReady;
  // Somber notification when the pet is close to running away due to neglect
  static bool wasRunReady = false;
  bool runReady = pet.canRunawayNow();
  if (runReady && !wasRunReady) sfxPlay(SFX_DENY);
  wasRunReady = runReady;

  handleTouch();
  handleSerial();
  ensureMon();

  // PWR: a short press toggles the display; holding for 4 seconds cuts power
  // die Batterie-Versorgung ab. Bei USB-Versorgung bleibt das Board ggf.
  // weiterhin ueber USB gespeist.
  const PwrButtonEvent pwrEvent = pwrPoll();
  if (pwrEvent == PWR_EVENT_LONG) {
    pet.flushSave();
    screenOff = true;
    Set_Backlight(0);
    audioSetIdle(true);
    batPowerOff();
  } else if (pwrEvent == PWR_EVENT_SHORT) {
    screenOff = !screenOff;
    if (!screenOff) wakeUI();
  }

  updateBrightness(now);

  // Battery safety limit (without USB): save the game and switch off the PMU before the
  // cell discharges further; the RTC keeps the time
  if (batShouldShutdown() && !usbPresent()) {
    pet.flushSave();
    Set_Backlight(0);
    batPowerOff();
  }

  // Flush periodic autosaves ONLY while the display is dimmed/off or the pet is asleep:
  // writing to NVS freezes both cores for about 1 s (flash cache is disabled),
  // so no animation is interrupted and no touch has to wait for a response. After 90 s
  // of inactivity the display is already dimmed, so the save happens immediately; active
  // play is still persisted by each action (feeding, playing, etc.).
  if (pet.savePending() && (screenOff || dimStage >= 1 || pet.sleeping)) {
    pet.flushSave();
  }

  // Record the real time every 30 s (it is persisted with each game save)
  static uint32_t lastClock = 0;
  if (now - lastClock > 30000) {
    lastClock = now;
    uint32_t e = rtcEpoch();
    if (e) pet.lastSeenEpoch = e;
  }

  // Health heartbeat every 5 min (for soak testing; discarded if no serial monitor is attached)
  static uint32_t lastHealth = 0;
  if (now - lastHealth > 300000) {
    lastHealth = now;
    Serial.printf("HEALTH up=%lus heap=%u min=%u bat=%d%% mv=%d chg=%d usb=%d dim=%u off=%d\n",
                  (unsigned long)(now / 1000), ESP.getFreeHeap(), ESP.getMinFreeHeap(),
                  batPercent(), batMillivolts(), batCharging() ? 1 : 0,
                  usbPresent() ? 1 : 0, dimStage, screenOff ? 1 : 0);
  }

  // Rendering cadence (power.h): 10 fps while the pet is active, slower after longer idle periods;
  // 85 ms during the game/training bag (safe margin so redraw does not overlap the previous
  // frame's DMA transfer; overlap at 40-65 ms caused black flashes).
  // When the display is off, do not draw: at brightness 0 nothing is visible, but redraws and
  // framebuffer DMA flushes were still running at 10 fps, measured at 70 ms of
  // work per 100 ms (46 ms of that was just the transfer). Each render redraws the entire scene,
  // so there is no partial frame; keeping lastRender frozen makes the first
  // frame after wake-up appear immediately.
  PowerCtx pc = powerCtx(millis());
  audioSetIdle(!amplifierWanted(pc));  // The amplifier uses power while idle
  batSetPollMs(powerCacheMs(pc));
  uint32_t interval = frameIntervalMs(pc);
  bool drewFrame = false;
  if (interval && now - lastRender >= interval) {
    lastRender = now;
    drewFrame = render();
  }
  // Yield the CPU on passes that do not draw; otherwise the loop runs at full speed
  // between frames. A 1 ms delay is not noticeable to touch (polled every 20 ms) and does not delay frames.
  if (!drewFrame) idleWait(pc);
}

// Current power state (see power.h)
PowerCtx powerCtx(uint32_t now) {
  PowerCtx c;
  c.idleMs = idleSince(now, lastInteract);
  c.screenOff = screenOff;
  c.sleeping = pet.sleeping;
  c.gameOpen = gameOpen || sackOpen;
  c.usb = usbPresent();
  c.charging = batCharging();
  c.batPct = batPercent();
  return c;
}

// The user interacted: restore the normal rendering cadence without waiting for the next
// frame in a slow cadence, and enable the amplifier before any sound is played
void wakeUI() {
  uint32_t now = millis();
  uint32_t iv = frameIntervalMs(powerCtx(now));
  bool slow = !iv || iv > 100;  // When the display is off or the cadence is slow, draw immediately instead of waiting for a frame
  lastInteract = now;
  // The forced frame still respects the 85 ms gap between redraws (otherwise it overlaps the previous DMA transfer)
  if (slow) lastRender = (now - lastRender >= 85) ? 0 : lastRender - 15;
  audioSetIdle(false);
}

// Brightness based on sleep + inactivity (AMOLED protection) and battery level
void updateBrightness(uint32_t now) {
  // Visible events wake the display automatically
  if (!screenOff && (pet.evolving() || pet.ceremony || pet.eating() || pet.showHeart())) {
    if (dimStageFor(idleSince(now, lastInteract)) != DIM_AWAKE) wakeUI();
    else lastInteract = now;
  }
  PowerCtx c = powerCtx(now);
  dimStage = dimStageFor(c.idleMs);
  uint8_t target = brightnessFor(c);
  static uint8_t current = 255;
  if (target != current) {
    current = target;
    Set_Backlight((uint8_t)(((uint16_t)target * 100U + 127U) / 255U));
  }
}

// Pause one loop iteration that did not draw. With the display off, or almost off,
// (5 min without interaction), and without USB, put the CPU into light sleep until the next frame or
// 200 ms. The timer or a touch (the touch INT line goes low) wakes it. Do not sleep with USB,
// so the SD card's serial port is not lost; check USB without caching in case it was just connected.
void idleWait(PowerCtx c) {
  // Do not sleep immediately after drawing (the frame DMA transfer may still be running) or while a sound is playing
  if (lightSleepAllowed(c) && millis() - lastRender >= 100 && !audioBusy()) {
    c.usb = usbPresentNow();
    if (!lightSleepAllowed(c)) { delay(idleDelayMs(c)); return; }
    if (digitalRead(TP_INT) == LOW) { gTouchIrq = true; delay(1); return; }  // Pending touch: do not enter sleep
    uint32_t ms = POWER_SLEEP_MS;
    uint32_t iv = frameIntervalMs(c);
    if (iv) {  // Display is on: sleep only until the next frame
      uint32_t due = lastRender + iv - millis();
      if ((int32_t)due < (int32_t)ms) ms = (int32_t)due > 1 ? due : 1;
    }
    esp_sleep_enable_timer_wakeup((uint64_t)ms * 1000);
    gpio_wakeup_enable((gpio_num_t)TP_INT, GPIO_INTR_LOW_LEVEL);
    esp_sleep_enable_gpio_wakeup();
    esp_light_sleep_start();
    // The touch interrupt returns to edge-triggered mode (as attachInterrupt configured it); a touch
    // that has already pulled the line low is registered manually
    gpio_wakeup_disable((gpio_num_t)TP_INT);
    gpio_set_intr_type((gpio_num_t)TP_INT, GPIO_INTR_NEGEDGE);
    if (digitalRead(TP_INT) == LOW) gTouchIrq = true;
    return;
  }
  delay(idleDelayMs(c));
}

// ---------- consola serie (provision de SD + depuracion) ----------

void handleSerial() {
  if (!Serial.available()) return;
  String line = Serial.readStringUntil('\n');
  line.trim();
  if (line.length() == 0) return;
  if (sdSerialCommand(line)) return;

  if (line == "HATCH") {
    pet.eggTap(); pet.eggTap(); pet.eggTap();
    Serial.println("DONE");
  } else if (line.startsWith("SPEC ")) {
    int n = line.substring(5).toInt();
    if (n >= 1 && n <= DEX_COUNT) {
      pet.prevSpeciesId = pet.speciesId;
      pet.speciesId = n;
      Serial.printf("especie #%d %s\n", n, DEX_TBL[n].name);
    }
    Serial.println("DONE");
  } else if (line.startsWith("LVL ")) {
    pet.ageMinutes = (uint32_t)line.substring(4).toInt() * MINUTES_PER_LEVEL;
    Serial.println("DONE");
  } else if (line.startsWith("TIME ")) {
    uint32_t e = (uint32_t)line.substring(5).toInt();
    rtcSetEpoch(e);
    pet.setClock(e);
    Serial.printf("rtc=%u\n", rtcEpoch());
    Serial.println("DONE");
  } else if (line.startsWith("RTCSET ")) {  // RTC only (simulate power-off periods in tests)
    rtcSetEpoch((uint32_t)line.substring(7).toInt());
    Serial.printf("rtc=%u\n", rtcEpoch());
    Serial.println("DONE");
  } else if (line == "TIME") {
    Serial.printf("rtc=%u\n", rtcEpoch());
    Serial.println("DONE");
  } else if (line == "GAL") {
    galleryOpen = !galleryOpen;
    galleryDetail = 0;
    galleryDirty = true;
    if (!galleryOpen) galleryPmd.unload();
    Serial.println("DONE");
  } else if (line == "EGGS") {
    // Simulate 20 egg rolls (does not change the game state)
    for (int i = 0; i < 20; i++) {
      int16_t d = pet.pickEggSpecies();
      Serial.printf("%d:%s(r%u) ", d, DEX_TBL[d].name, DEX_TBL[d].rarity);
    }
    Serial.println();
    Serial.println("DONE");
  } else if (line == "SHINY") {  // Toggle shiny status for the current pet (tests)
    pet.shiny = !pet.shiny;
    Serial.printf("shiny=%d\n", pet.shiny);
    Serial.println("DONE");
  } else if (line.startsWith("NICK ")) {
    pet.rename(line.substring(5).c_str());
    Serial.printf("nick=%s\n", pet.nick);
    Serial.println("DONE");
  } else if (line == "CAREDAY") {  // Simulate a new day of care (tests)
    pet.setClock(pet.lastSeenEpoch + 86400);
    pet.caress();
    Serial.printf("streak=%u bond=%u medals=0x%X\n", pet.streak, pet.bond, pet.medals);
    Serial.println("DONE");
  } else if (line == "BYE") {
    pet.startFarewell();
    Serial.println("DONE");
  } else if (line == "RUN") {
    pet.startRunaway();
    Serial.println("DONE");
  } else if (line == "BEEP") {
    sfxPlay(SFX_HATCH);  // Audio test
    Serial.println("DONE");
  } else if (line == "ABANDON") {
    pet.dbgRunawayReady();  // Force the 'ready to run away' state (button test)
    Serial.println("DONE");
  } else if (line == "WIPE") {
    pet.factoryReset();     // Clear NVS and reboot -> new game (starter selection)
    Serial.println("DONE");
    delay(100);
    ESP.restart();
  } else if (line == "REG") {
    Serial.printf("pokedex %u/151:", pet.registeredCount());
    for (int i = 1; i <= 151; i++)
      if (pet.isRegistered(i)) Serial.printf(" %d", i);
    Serial.println();
    Serial.println("DONE");
  } else if (line == "HEALTH") {
    Serial.printf("up=%lus heap=%u min=%u sd=%d mon=%d\n",
                  (unsigned long)(millis() / 1000), ESP.getFreeHeap(),
                  ESP.getMinFreeHeap(), sdReady, pmd.loaded || mon.loaded);
    Serial.println("DONE");
  } else if (line == "STATS") {
    Serial.printf("spec=%d nv=%u com=%u fel=%u ene=%u lim=%u desc=%u sd=%d mon=%d bat=%d usb=%d rtc=%u\n",
                  pet.speciesId, pet.level(), pet.fullness, pet.joy, pet.energy,
                  pet.hygiene, pet.careMistakes, sdReady, mon.loaded,
                  batPercent(), usbPresent(), rtcEpoch());
    Serial.printf("peso=%u fue=%u def=%u vel=%u genes=%u/%u/%u tr=%u/%u/%u baya=%d\n",
                  pet.weight, pet.atkStat(), pet.defStat(), pet.speStat(),
                  pet.geneAtk, pet.geneDef, pet.geneSpe,
                  pet.trAtk, pet.trDef, pet.trSpe, pet.berryKnown);
    Serial.printf("shiny=%d streak=%u/%u bond=%u medals=0x%X(%u) nick=%s\n",
                  pet.shiny, pet.streak, pet.bestStreak, pet.bond, pet.medals,
                  pet.totalMedals, pet.nick);
    Serial.println("DONE");
  }
}

// ---------- Touch input ----------

bool inPetZone(int16_t x, int16_t y) {
  return x > 110 && x < 356 && y > 95 && y < 310;
}

// Resolve the touch when the finger is LIFTED to distinguish a tap from a swipe
void handleTouch() {
  static uint32_t lastPoll = 0;
  if (millis() - lastPoll < 20) return;  // 50 Hz is more than enough for a finger
  lastPoll = millis();
  // Query the dedicated CST816 bus only when INT signals an event or the finger remains
  // down (to detect when it is lifted).
  if (!gTouchIrq && !wasPressed) return;
  gTouchIrq = false;
  // Previous I2C address used for verification on the separate Touch bus.
  TouchWire.beginTransmission(CST816_ADDR);
  if (TouchWire.endTransmission() != 0) return;  // CST816 no responde; reintento en 20 ms
  int16_t x, y;
  bool pressed = touch.getPoint(&x, &y, 1) > 0;

  // Diagnostik: einen Datensatz pro neuem Fingerdruck ausgeben.
  // The values have already been transformed to the logical 466x466 game area.
  if (pressed && !wasPressed) {
    Serial.printf("[TOUCH] DOWN x=%d y=%d  INT=%d\n",
                  x, y, digitalRead(TP_INT));
  }

  // Training bag: count each touch immediately (rapid tapping)
  if (sackOpen) {
    if (pressed && !wasPressed) {
      wakeUI();
      if (y < 72) sackOpen = false;  // Tap at the top = abandon
      else sackTap();
    }
    wasPressed = pressed;
    return;
  }

  if (pressed && !wasPressed) {  // Gesture start
    tX0 = tXl = x;
    tY0 = tYl = y;
    tStart = millis();
    holdFired = false;
    swallowGesture = (dimStage > 0) || screenOff;  // If the display was dark, only wake it
    screenOff = false;
    wakeUI();
  } else if (pressed) {  // Finger is still down
    tXl = x;
    tYl = y;
    // Long press without moving on the pet -> show the release dialog
    if (!holdFired && !swallowGesture && !galleryOpen && !cardOpen && !kbOpen && !clockOpen && millis() - tStart > 3000 &&
        abs(tXl - tX0) < 30 && abs(tYl - tY0) < 30 && inPetZone(tX0, tY0) &&
        !pet.isEgg() && !confirmUntil && !pet.ceremony) {
      confirmUntil = millis() + 10000;
      holdFired = true;
    }
  } else if (wasPressed) {  // Finger lifted: resolve the gesture
    wakeUI();
    int dx = tXl - tX0, dy = tYl - tY0;
    uint32_t dt = millis() - tStart;
    Serial.printf("[TOUCH] UP start=%d,%d last=%d,%d delta=%d,%d dt=%lu\n",
                  tX0, tY0, tXl, tYl, dx, dy, (unsigned long)dt);
    if (!holdFired && !swallowGesture) {
      if (abs(dx) > 80 && abs(dy) < 70 && dt < 800) onSwipe(dx > 0 ? 1 : -1);
      else if (abs(dy) > 80 && abs(dx) < 70 && dt < 800) onSwipeV(dy > 0 ? 1 : -1);
      else if (dt < 1500 && abs(dx) < 40 && abs(dy) < 40) onTap(tX0, tY0);
    }
  }
  wasPressed = pressed;
}

// Vertical swipe: open/close the pet card
void openClock();  // prototipo

void onSwipeV(int dir) {
  if (pet.awaitingStarter()) return;  // Disabled while choosing the starter
  if (gameOpen || galleryOpen || kbOpen || sackOpen || pet.ceremony) return;
  if (clockOpen) { clockOpen = false; return; }
  if (cardOpen) {
    if (dir < 0) cardOpen = false;  // Swipe up closes the card
    return;
  }
  if (dir > 0) {                    // Swipe down: adjust the clock
    if (!confirmUntil && !feedMenuUntil) openClock();
  } else if (!pet.isEgg() && !confirmUntil && !feedMenuUntil) {
    cardOpen = true;                // Swipe up: open the card
    cardPage = 0;
  }
}

// Swipe: dir +1 = right
void onSwipe(int dir) {
  if (pet.awaitingStarter()) return;  // Disabled while choosing the starter
  if (gameOpen || kbOpen || clockOpen) return;
  if (cardOpen) {  // Inside the card: switch between the four pages
    int p = (int)cardPage + (dir > 0 ? -1 : 1);  // Swipe left advances
    cardPage = p < 0 ? 0 : (p > 3 ? 3 : p);
    return;
  }
  if (!galleryOpen) {
    if (!pet.ceremony && !confirmUntil) {
      galleryOpen = true;
      galleryPage = 0;
      galleryDetail = 0;
      galleryDirty = true;
    }
    return;
  }
  if (galleryDetail) {  // In detail view: return to the grid
    galleryDetail = 0;
    galleryPmd.unload();
    galleryDirty = true;
    return;
  }
  int np = galleryPage - dir;  // Swipe left advances to the next page
  if (np < 0) {                // Swipe back from the first page = exit
    galleryOpen = false;
    galleryPmd.unload();
    return;
  }
  if (np > 9) np = 9;
  if (np != galleryPage) {
    galleryPage = np;
    galleryDirty = true;
  }
}

void onTap(int16_t x, int16_t y) {
  // Serial.printf("TOUCH %d %d\n", x, y);  // diagnostic (silenced: it floods the log)
  if (pet.awaitingStarter()) {  // First run: choose a starter
    for (int i = 0; i < 3; i++) {
      int ry = STARTER_ROW_Y + i * (STARTER_ROW_H + STARTER_ROW_GAP);
      if (x >= 70 && x <= 396 && y >= ry && y <= ry + STARTER_ROW_H) {
        pet.chooseStarter(STARTER_DEX[i]);
        sfxPlay(SFX_TAP);
        break;
      }
    }
    return;
  }
  if (galleryOpen) {
    galleryTap(x, y);
    return;
  }
  if (kbOpen) {
    keyboardTap(x, y);
    return;
  }
  if (clockOpen) {
    clockTap(x, y);
    return;
  }
  if (pet.ceremony) return;  // No buttons are available during the farewell
  if (cardOpen) {
    if (cardPage == 0 && y < 84) openKeyboard();  // Tap the name to rename the pet
    else if (cardPage == 1 && y >= 300 && y <= 340 && x >= 96 && x <= 370) {
      cardOpen = false;            // boton ENTRENAR FUERZA
      startSack();
    } else {
      cardOpen = false;
    }
    return;
  }
  if (gameOpen) {
    gameTap(x, y);
    return;
  }
  if (choiceKind) {          // Decision dialog: action button (top) / keep button (bottom)
    bool b1 = (x >= 93 && x <= 373 && y >= 206 && y <= 258);  // accion
    bool b2 = (x >= 93 && x <= 373 && y >= 268 && y <= 320);  // Keep / stay
    if (choiceKind == 1) {                 // Evolution
      if (b1) { int16_t old = pet.speciesId; pet.evolve(); evoPmd.load(old, pet.shiny); }
      else if (b2) pet.declineEvolve();
    } else if (choiceKind == 2) {          // Farewell
      if (b1) pet.startFarewell();
      else if (b2) pet.declineFarewell();
    }
    choiceKind = 0;
    return;
  }
  if (confirmUntil) {        // Release dialog: YES / NO
    if (timeLeft(confirmUntil) && x >= 118 && x <= 218 && y >= 252 && y <= 304) {
      pet.release();
    }
    confirmUntil = 0;
    return;
  }
  if (feedMenuUntil) {       // Food selector
    if (timeLeft(feedMenuUntil) && y >= 288 && y <= 352 && x >= 101 && x <= 365) {
      int item = (x - 101) / 66;
      if (item == 3) pet.feedCandy();
      else pet.feedBerry(item);
      sfxPlay(SFX_EAT);
    }
    feedMenuUntil = 0;
    return;
  }
  if (pet.isEgg()) {
    pet.eggTap();
    sfxPlay(SFX_TAP);
    return;
  }
  // Evolution button: open the evolve/keep dialog
  if (pet.wantEvolveButton() && x >= EVO_BTN_X && x <= EVO_BTN_X + EVO_BTN_W &&
      y >= EVO_BTN_Y && y <= EVO_BTN_Y + EVO_BTN_H) {
    choiceKind = 1; choiceUntil = millis() + 12000;
    return;
  }
  // End-state buttons (same box): runaway is direct; farewell opens a dialog
  if (x >= FAR_BTN_X && x <= FAR_BTN_X + FAR_BTN_W &&
      y >= FAR_BTN_Y && y <= FAR_BTN_Y + FAR_BTN_H) {
    if (pet.canRunawayNow()) { pet.startRunaway(); return; }
    if (pet.wantFarewellButton()) { choiceKind = 2; choiceUntil = millis() + 12000; return; }
  }
  for (int i = 0; i < 4; i++) {
    int dx = x - buttons[i].cx, dy = y - buttons[i].cy;
    if (dx * dx + dy * dy <= BTN_HIT * BTN_HIT) {
      Serial.printf("BTN %d\n", i);
      sfxPlay(SFX_TAP);
      if (i == 0) {
        if (!pet.sleeping) feedMenuUntil = millis() + 6000;
      } else if (i == 1) {
        startGame();
      } else if (i == 2) {
        pet.toggleLight();
      } else {
        startBath();
      }
      return;
    }
  }
  // Tap the pet = pet it
  if (inPetZone(x, y)) {
    Serial.println("PET");
    pet.caress();
    if (!pet.sleeping) sfxPlay(SFX_HEART);
  }
}

// ---------- Rendering ----------

bool gNight = false;  // Use real nighttime (clock) or sleep state; render() sets this flag
uint16_t inkColor() { return gNight ? UI_INK_NIGHT : UI_INK; }

// ---------- Background scene: type biome + real-time RTC clock ----------

#define C565(r, g, b) ((uint16_t)((((r) >> 3) << 11) | (((g) >> 2) << 5) | ((b) >> 3)))
#define HORIZON 232  // Horizon line where the sky meets the ground

uint16_t lerp565(uint16_t a, uint16_t b, int i, int n) {
  if (n <= 0) return a;
  int ar = (a >> 11) & 31, ag = (a >> 5) & 63, ab = a & 31;
  int br = (b >> 11) & 31, bg = (b >> 5) & 63, bb = b & 31;
  return (uint16_t)((((ar + (br - ar) * i / n) << 11)) |
                    (((ag + (bg - ag) * i / n) << 5)) | (ab + (bb - ab) * i / n));
}

// Time of day, 0-23 (real time cached every 30 s; use 13 if no clock is available)
int sceneHour() {
  uint32_t e = pet.lastSeenEpoch;
  return e ? (int)((e / 3600) % 24) : 13;
}

// Daytime ground color for each biome (at night it blends toward the night blue)
static const uint16_t BIOME_SOIL[6] = {
  C565(0x7e, 0xc0, 0x7f),  // 0 meadow
  C565(0xdc, 0xca, 0x94),  // 1 beach (sand)
  C565(0x4f, 0x8a, 0x55),  // 2 forest
  C565(0x8a, 0x55, 0x44),  // 3 volcano
  C565(0xa8, 0x90, 0x6a),  // 4 mountain
  C565(0xe6, 0xee, 0xf5),  // 5 snow
};

void drawClouds(uint32_t now, uint16_t col) {
  for (int k = 0; k < 2; k++) {
    int cx = (int)((now / 50 + k * 250) % 560) - 40;
    int cy = 70 + k * 34;
    gfx->fillCircle(cx, cy, 16, col);
    gfx->fillCircle(cx + 18, cy + 3, 13, col);
    gfx->fillCircle(cx - 15, cy + 4, 12, col);
  }
}

void drawScene(uint8_t biome, uint32_t now, bool night) {
  int h = sceneHour();
  uint16_t top, bot;
  if (night)            { top = C565(0x0c, 0x12, 0x24); bot = C565(0x1e, 0x26, 0x46); }
  else if (h < 8)       { top = C565(0xd1, 0x6a, 0x86); bot = C565(0xf3, 0xb8, 0x7c); }  // amanecer
  else if (h < 18)      { top = C565(0x8f, 0xc8, 0xea); bot = C565(0xdc, 0xee, 0xe6); }  // Day
  else                  { top = C565(0xc7, 0x5a, 0x4a); bot = C565(0xf0, 0xae, 0x64); }  // atardecer

  // Banded sky
  for (int y = 0; y < HORIZON; y += 8)
    gfx->fillRect(0, y, 466, 8, lerp565(top, bot, y, HORIZON));

  // sol o luna
  if (night) {
    gfx->fillCircle(360, 78, 24, C565(0xe8, 0xee, 0xf5));
    gfx->fillCircle(370, 72, 22, lerp565(top, bot, 78, HORIZON));  // creciente
    for (auto &st : STARS) gfx->fillRect(st[0], st[1], 4, 4, UI_WHITE);
  } else if (h < 18) {
    gfx->fillCircle(360, 84, 26, h < 8 ? C565(0xff, 0xd9, 0x8a) : C565(0xff, 0xe7, 0x9f));
    drawClouds(now, C565(0xff, 0xff, 0xff));
  } else {
    gfx->fillCircle(233, HORIZON - 6, 34, C565(0xff, 0xf1, 0xc8));  // sol poniente
  }

  // Beach sea: a strip of water above the sand
  uint16_t soil = BIOME_SOIL[biome < 6 ? biome : 0];
  if (night) soil = lerp565(soil, C565(0x16, 0x1c, 0x30), 9, 16);
  if (biome == 1) {
    uint16_t sea = night ? C565(0x1c, 0x34, 0x52) : C565(0x4f, 0x96, 0xc4);
    gfx->fillRect(0, HORIZON - 26, 466, 26, sea);
    for (int i = 0; i < 3; i++) {
      int wy = HORIZON - 22 + i * 7;
      uint16_t fc = night ? C565(0x3a, 0x58, 0x78) : C565(0xbf, 0xe6, 0xf5);
      gfx->fillRect(60 + ((now / 60 + i * 30) % 60), wy, 26, 2, fc);
      gfx->fillRect(300 - ((now / 60 + i * 20) % 60), wy, 26, 2, fc);
    }
  }

  // Ground
  gfx->fillRect(0, HORIZON, 466, 466 - HORIZON, soil);
  uint16_t hill = lerp565(soil, night ? C565(0x0c, 0x12, 0x24) : C565(0xff, 0xff, 0xff), 3, 16);
  gfx->fillRoundRect(-60, HORIZON - 14, 586, 60, 30, hill);

  // Biome details
  uint16_t dk = lerp565(soil, C565(0x10, 0x18, 0x20), night ? 11 : 7, 16);
  if (biome == 2) {  // Forest: conifer silhouettes
    for (int tx : { 60, 150, 360, 416 }) {
      gfx->fillTriangle(tx, HORIZON - 46, tx - 16, HORIZON, tx + 16, HORIZON, dk);
      gfx->fillTriangle(tx, HORIZON - 60, tx - 12, HORIZON - 28, tx + 12, HORIZON - 28, dk);
    }
  } else if (biome == 3) {  // Volcano: rocks and embers
    gfx->fillTriangle(70, HORIZON, 40, HORIZON + 30, 100, HORIZON + 30, dk);
    gfx->fillTriangle(400, HORIZON + 4, 372, HORIZON + 30, 430, HORIZON + 30, dk);
    if (!night)
      for (int e = 0; e < 4; e++)
        gfx->fillRect(120 + e * 70, HORIZON + 8 + (e % 2) * 6, 4, 4, C565(0xff, 0x9b, 0x3a));
  } else if (biome == 4) {  // Mountain: distant peaks
    gfx->fillTriangle(140, HORIZON - 50, 60, HORIZON, 220, HORIZON, dk);
    gfx->fillTriangle(330, HORIZON - 38, 250, HORIZON, 410, HORIZON, dk);
  } else if (biome == 5 && !night) {  // Snow: falling flakes
    for (int f = 0; f < 10; f++) {
      int fx = (f * 53 + now / 40) % 466;
      int fy = (f * 90 + now / 18) % HORIZON;
      gfx->fillRect(fx, fy, 3, 3, UI_WHITE);
    }
  } else if (biome == 0) {  // Meadow: grass tufts
    for (int gx : { 80, 175, 300, 395 })
      for (int b = -1; b <= 1; b++)
        gfx->fillRect(gx + b * 5, HORIZON + 6, 2, 8 + (b == 0 ? 4 : 0), dk);
  }
}

